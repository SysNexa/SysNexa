    <section class="content-section" id="contact">
      <div class="container booking-grid">

        <div class="booking-info">
          <div class="eyebrow">Get Technical Help</div>
          <h2>Let's Fix Your <span style="color:var(--blue)">Tech Problems.</span></h2>

          <p>
            Submit a service request with your device details and a brief
            description of the problem. Our team can follow up using the
            contact information you provide.
          </p>

          <div class="contact-line">
            <div class="device-icon">📧</div>
            <div>
              <strong>Email Support</strong>
              <small>YOUR_EMAIL@example.com</small>
            </div>
          </div>

          <div class="contact-line">
            <div class="device-icon">📞</div>
            <div>
              <strong>Phone / WhatsApp</strong>
              <small>YOUR_PHONE_NUMBER</small>
            </div>
          </div>

          <div class="contact-line">
            <div class="device-icon">📍</div>
            <div>
              <strong>Service Location</strong>
              <small>YOUR CITY / SERVICE AREA</small>
            </div>
          </div>
        </div>

        <form class="booking-form" id="repairForm">
          <h3>Request a Repair</h3>
          <p class="form-intro">
            Complete the form to prepare your service request.
          </p>

          <div class="form-grid">

            <div class="field">
              <label for="name">Full Name *</label>
              <input id="name" name="name" type="text"
                autocomplete="name" required maxlength="100"
                placeholder="Your name">
            </div>

            <div class="field">
              <label for="phone">Phone Number *</label>
              <input id="phone" name="phone" type="tel"
                autocomplete="tel" required maxlength="25"
                placeholder="Your contact number">
            </div>

            <div class="field">
              <label for="email">Email Address</label>
              <input id="email" name="email" type="email"
                autocomplete="email" maxlength="150"
                placeholder="you@example.com">
            </div>

            <div class="field">
              <label for="device">Device Type *</label>
              <select id="device" name="device" required>
                <option value="">Select a device</option>
                <option>Desktop Computer</option>
                <option>Laptop</option>
                <option>Mobile / Smartphone</option>
                <option>Tablet</option>
                <option>Network / Router</option>
                <option>Printer / Peripheral</option>
                <option>Multiple Devices</option>
                <option>Other IT Equipment</option>
              </select>
            </div>

            <div class="field full">
              <label for="service">Service Required *</label>
              <select id="service" name="service" required>
                <option value="">Select a service</option>
                <option>Desktop Repair</option>
                <option>Laptop Repair</option>
                <option>Mobile Repair</option>
                <option>Network Troubleshooting</option>
                <option>Hardware Upgrades</option>
                <option>OS & Software Installation</option>
                <option>System Troubleshooting</option>
                <option>Security & Virus Removal</option>
                <option>Business IT Support</option>
                <option>Other Technical Issue</option>
              </select>
            </div>

            <div class="field full">
              <label for="issue">Describe the Problem *</label>
              <textarea id="issue" name="issue" required
                maxlength="2000"
                placeholder="Describe the issue, device model and any error messages..."></textarea>
            </div>

            <div class="field full">
              <label for="location">Your Location / Area</label>
              <input id="location" name="location" type="text"
                maxlength="200"
                placeholder="City or area">
            </div>

          </div>

          <button type="submit" class="btn btn-primary form-submit">
            Continue with WhatsApp →
          </button>

          <p class="privacy-note">
            Your request will open in WhatsApp for you to review and send.
            Do not include passwords or sensitive personal information.
          </p>
        </form>

      </div>
    </section>

