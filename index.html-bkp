  <!-- Replace the placeholder number in the JavaScript below. -->
  <a class="whatsapp"
     href="https://wa.me/"
     id="whatsappLink"
     target="_blank"
     rel="noopener noreferrer"
     aria-label="Contact us on WhatsApp"
     title="Contact us on WhatsApp">W</a>

  <script>
    /*
      SETUP:
      1. Replace the example WhatsApp number below with your business number.
      2. Use the country code and number only, with no +, spaces or dashes.
         Example format for India: 91XXXXXXXXXX
      3. Update the email, phone and location placeholders in the HTML.
    */

    const WHATSAPP_NUMBER = "91XXXXXXXXXX";

    // Mobile navigation
    const menuToggle = document.getElementById("menuToggle");
    const navLinks = document.getElementById("navLinks");

    menuToggle.addEventListener("click", () => {
      const isOpen = navLinks.classList.toggle("open");
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.textContent = isOpen ? "✕" : "☰";
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.textContent = "☰";
      });
    });

    // Current year
    document.getElementById("year").textContent =
      new Date().getFullYear();

    // Fill the service field when a service card is selected
    document.querySelectorAll("[data-service]").forEach(link => {
      link.addEventListener("click", () => {
        const service = link.dataset.service;
        const select = document.getElementById("service");

        const option = Array.from(select.options).find(
          item => item.value === service || item.text === service
        );

        if (option) {
          select.value = option.value;
        }
      });
    });

    // Configure the WhatsApp shortcut
    const whatsappLink = document.getElementById("whatsappLink");

    function validWhatsAppNumber(number) {
      return /^\d{8,15}$/.test(number);
    }

    if (validWhatsAppNumber(WHATSAPP_NUMBER)) {
      whatsappLink.href =
        "https://wa.me/" + WHATSAPP_NUMBER +
        "?text=" + encodeURIComponent(
          "Hello SysNexa, I need technical support."
        );
    } else {
      whatsappLink.href = "#contact";
      whatsappLink.removeAttribute("target");
    }

    // Prepare the repair request and open WhatsApp
    document.getElementById("repairForm").addEventListener(
      "submit", function(event) {
        event.preventDefault();

        if (!this.reportValidity()) return;

        if (!validWhatsAppNumber(WHATSAPP_NUMBER)) {
          alert(
            "Please configure your business WhatsApp number in the JavaScript before submitting requests."
          );
          return;
        }

        const data = new FormData(this);

        const message = [
          "Hello SysNexa! I would like to request a service.",
          "",
          "Name: " + data.get("name"),
          "Phone: " + data.get("phone"),
          "Email: " + (data.get("email") || "Not provided"),
          "Device: " + data.get("device"),
          "Service: " + data.get("service"),
          "Problem: " + data.get("issue"),
          "Location: " + (data.get("location") || "Not provided"),
          "",
          "Please contact me regarding this request."
        ].join("\n");

        const url = "https://wa.me/" + WHATSAPP_NUMBER +
          "?text=" + encodeURIComponent(message);

        window.open(url, "_blank", "noopener,noreferrer");
      }
    );
  </script>

</body>
