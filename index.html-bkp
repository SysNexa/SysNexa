
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#071426">

  <title>SysNexa | Computer, Laptop & Mobile Repair</title>

  <meta name="description"
    content="SysNexa provides desktop and laptop repair, mobile servicing, network troubleshooting, hardware upgrades, software installation and IT support.">

  <style>
    :root {
      --bg: #071426;
      --surface: #0d2038;
      --surface-light: #132b47;
      --blue: #38bdf8;
      --blue-dark: #1688d4;
      --text: #f4f8ff;
      --muted: #a8b8cc;
      --border: rgba(148, 190, 230, .16);
      --green: #39d98a;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

  html {
      scroll-behavior: smooth;
      scroll-padding-top: 90px;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: Inter, "Segoe UI", Arial, sans-serif;
      line-height: 1.7;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    button, input, select, textarea {
      font: inherit;
    }

    button, a {
      -webkit-tap-highlight-color: transparent;
    }

    .container {
      width: min(1160px, 92%);
      margin: auto;
    }

    .topbar {
      background: #04101f;
      border-bottom: 1px solid var(--border);
      color: var(--muted);
      padding: 8px 0;
      font-size: 12px;
    }

    .topbar .container {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(7, 20, 38, .94);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
    }

    .navbar {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 25px;
      font-weight: 850;
      letter-spacing: -.8px;
    }

    .logo-icon {
      width: 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      color: #061426;
      background: linear-gradient(135deg, #67e8f9, #38bdf8, #3b82f6);
      font-size: 22px;
    }

    .logo span {
      color: var(--blue);
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 25px;
      font-size: 14px;
      color: var(--muted);
    }

    .nav-links a:hover {
      color: var(--blue);
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      border: 1px solid transparent;
      border-radius: 9px;
      padding: 12px 19px;
      font-weight: 750;
      cursor: pointer;
      transition: .2s ease;
    }

    .btn-primary {
      background: var(--blue);
      color: #061426;
    }

    .btn-primary:hover {
      background: #7dd3fc;
      transform: translateY(-2px);
    }

    .btn-outline {
      border-color: var(--border);
      background: rgba(255,255,255,.03);
      color: var(--text);
    }

    .btn-outline:hover {
      border-color: var(--blue);
      color: var(--blue);
    }

    .menu-toggle {
      display: none;
      color: white;
      border: 1px solid var(--border);
      background: var(--surface);
      border-radius: 8px;
      padding: 7px 12px;
      cursor: pointer;
      font-size: 21px;
    }

    /* HERO */

    .hero {
      position: relative;
      overflow: hidden;
      padding: 100px 0 90px;
      background:
        radial-gradient(ellipse at 80% 20%, rgba(20, 135, 224, .20), transparent 40%),
        radial-gradient(ellipse at 10% 80%, rgba(56, 189, 248, .08), transparent 35%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.1fr .9fr;
      gap: 65px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      gap: 9px;
      align-items: center;
      color: var(--blue);
      font-weight: 800;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 12px var(--green);
    }

    h1 {
      font-size: clamp(38px, 5.3vw, 66px);
      line-height: 1.12;
      letter-spacing: -2.5px;
      margin-bottom: 22px;
    }

    h1 span {
      color: var(--blue);
    }

    .hero p {
      color: var(--muted);
      max-width: 590px;
      font-size: 17px;
      margin-bottom: 28px;
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .hero-note {
      margin-top: 24px;
      color: var(--muted);
      font-size: 12px;
    }

    .hero-visual {
      position: relative;
      min-height: 365px;
      display: grid;
      place-items: center;
    }

    .orbit {
      position: absolute;
      width: 310px;
      height: 310px;
      border: 1px solid rgba(56, 189, 248, .18);
      border-radius: 50%;
    }

    .orbit::before, .orbit::after {
      content: "";
      position: absolute;
      border: 1px solid rgba(56, 189, 248, .12);
      border-radius: 50%;
    }

    .orbit::before {
      inset: 25px;
    }

    .orbit::after {
      inset: 55px;
    }

    .device-card {
      position: relative;
      z-index: 1;
      width: min(100%, 360px);
      background: linear-gradient(145deg, #163452, #0b1b30);
      border: 1px solid rgba(56,189,248,.28);
      box-shadow: 0 25px 80px rgba(0,0,0,.35);
      border-radius: 23px;
      padding: 25px;
    }

    .device-card h3 {
      font-size: 17px;
      margin-bottom: 18px;
    }

    .device-row {
      display: flex;
      gap: 13px;
      align-items: center;
      padding: 13px 0;
      border-bottom: 1px solid var(--border);
    }

    .device-row:last-child {
      border-bottom: 0;
    }

    .device-icon {
      display: grid;
      place-items: center;
      width: 43px;
      height: 43px;
      border-radius: 12px;
      background: rgba(56,189,248,.12);
      font-size: 23px;
    }

    .device-row strong {
      display: block;
      font-size: 14px;
    }

    .device-row small {
      color: var(--muted);
      font-size: 12px;
    }

    /* TRUST STRIP */

    .trust-strip {
      background: #0b1d32;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .trust-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
    }

    .trust-item {
      padding: 24px 12px;
      text-align: center;
      border-right: 1px solid var(--border);
    }

    .trust-item:last-child {
      border: 0;
    }

    .trust-item strong {
      display: block;
      font-size: 15px;
    }

    .trust-item small {
      color: var(--muted);
      font-size: 12px;
    }

    /* GENERAL SECTIONS */

    section.content-section {
      padding: 85px 0;
    }

    .section-heading {
      max-width: 690px;
      margin: 0 auto 45px;
      text-align: center;
    }

    .section-heading h2 {
      font-size: clamp(29px, 4vw, 42px);
      line-height: 1.2;
      letter-spacing: -1px;
      margin-bottom: 15px;
    }

    .section-heading p {
      color: var(--muted);
    }

    .section-heading span {
      color: var(--blue);
    }

    /* SERVICES */

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 19px;
    }

    .service-card {
      padding: 25px;
      border: 1px solid var(--border);
      background: linear-gradient(145deg, #10243c, #0a192b);
      border-radius: 16px;
      transition: .25s;
    }

    .service-card:hover {
      transform: translateY(-5px);
      border-color: rgba(56,189,248,.55);
      box-shadow: 0 14px 35px rgba(0,0,0,.18);
    }

    .service-icon {
      width: 53px;
      height: 53px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: rgba(56,189,248,.12);
      font-size: 27px;
      margin-bottom: 18px;
    }

    .service-card h3 {
      font-size: 18px;
      margin-bottom: 10px;
    }

    .service-card p {
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 17px;
    }

    .service-card a {
      color: var(--blue);
      font-size: 13px;
      font-weight: 750;
    }

    /* ABOUT */

    .about {
      background: #0a1a2d;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 55px;
      align-items: center;
    }

    .about h2 {
      font-size: clamp(30px, 4vw, 43px);
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .about p {
      color: var(--muted);
      margin-bottom: 20px;
    }

    .check-list {
      list-style: none;
      display: grid;
      gap: 12px;
      margin: 23px 0;
    }

    .check-list li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }

    .check-list li span {
      color: var(--green);
    }

    .about-panel {
      border: 1px solid var(--border);
      background: linear-gradient(135deg, #102b48, #0b1b2f);
      border-radius: 20px;
      padding: 30px;
    }

    .about-panel h3 {
      font-size: 21px;
      margin-bottom: 20px;
    }

    .step {
      display: flex;
      gap: 15px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    .step:last-child {
      border: 0;
    }

    .step-number {
      min-width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      background: rgba(56,189,248,.13);
      color: var(--blue);
      border-radius: 10px;
      font-weight: 800;
    }

    .step p {
      font-size: 13px;
      margin: 4px 0 0;
    }

    /* BOOKING */

    .booking-grid {
      display: grid;
      grid-template-columns: .8fr 1.2fr;
      gap: 40px;
      align-items: start;
    }

    .booking-info h2 {
      font-size: 36px;
      line-height: 1.2;
      margin-bottom: 18px;
    }

    .booking-info p {
      color: var(--muted);
      margin-bottom: 24px;
    }

    .contact-line {
      display: flex;
      gap: 12px;
      align-items: flex-start;
      padding: 15px 0;
      border-bottom: 1px solid var(--border);
    }

    .contact-line strong {
      display: block;
      font-size: 14px;
    }

    .contact-line small {
      color: var(--muted);
      overflow-wrap: anywhere;
    }

    .booking-form {
      padding: 30px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
    }

    .booking-form h3 {
      font-size: 23px;
      margin-bottom: 5px;
    }

    .form-intro {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 22px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .field.full {
      grid-column: 1 / -1;
    }

    .field label {
      font-size: 13px;
      font-weight: 700;
    }

    .field input, .field select, .field textarea {
      width: 100%;
      min-width: 0;
      padding: 12px 13px;
      border: 1px solid #29415d;
      border-radius: 8px;
      outline: none;
      background: #071629;
      color: var(--text);
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(56,189,248,.08);
    }

    .field textarea {
      resize: vertical;
      min-height: 110px;
    }

    .field select option {
      background: #071629;
    }

    .form-submit {
      width: 100%;
      margin-top: 20px;
    }

    .privacy-note {
      color: var(--muted);
      font-size: 11px;
      margin-top: 12px;
      text-align: center;
    }

    /* CTA */

    .cta {
      padding: 60px 0;
      background: linear-gradient(110deg, #10365a, #0d2340);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }

    .cta-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 25px;
    }

    .cta h2 {
      font-size: clamp(25px, 3vw, 35px);
      line-height: 1.3;
    }

    .cta p {
      color: #c4d5e9;
      margin-top: 8px;
    }

    /* FOOTER */

    footer {
      padding: 45px 0 20px;
      background: #040e1b;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 40px;
      padding-bottom: 35px;
    }

    .footer-about p {
      max-width: 370px;
      color: var(--muted);
      font-size: 13px;
      margin-top: 15px;
    }

    .footer-column h4 {
      margin-bottom: 14px;
    }

    .footer-column a {
      display: block;
      color: var(--muted);
      font-size: 13px;
      margin: 8px 0;
    }

    .footer-column a:hover {
      color: var(--blue);
    }

    .copyright {
      border-top: 1px solid var(--border);
      padding-top: 18px;
      display: flex;
      justify-content: space-between;
      gap: 12px;
      flex-wrap: wrap;
      color: var(--muted);
      font-size: 12px;
    }

    /* FLOATING WHATSAPP */

    .whatsapp {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 99;
      width: 55px;
      height: 55px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: #25d366;
      color: #052d18;
      font-size: 26px;
      font-weight: 900;
      box-shadow: 0 8px 30px rgba(0,0,0,.3);
      transition: .2s;
    }

    .whatsapp:hover {
      transform: scale(1.07);
    }

    @media (max-width: 900px) {
      .hero-grid, .about-grid, .booking-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 70px 0;
      }

      .hero-visual {
        min-height: 340px;
      }

      .services-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .about-grid, .booking-grid {
        gap: 32px;
      }
    }

    @media (max-width: 680px) {
      .topbar .container {
        justify-content: center;
        text-align: center;
      }

      .navbar {
        min-height: 68px;
      }

      .logo {
        font-size: 22px;
      }

      .menu-toggle {
        display: block;
      }

      .nav-links {
        display: none;
        position: absolute;
        top: 68px;
        left: 0;
        right: 0;
        padding: 20px 5%;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: #071426;
        border-bottom: 1px solid var(--border);
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 12px 0;
        border-bottom: 1px solid var(--border);
      }

      .nav-links .btn {
        margin-top: 12px;
      }

      h1 {
        letter-spacing: -1.5px;
      }

      .hero p {
        font-size: 15px;
      }

      .hero-visual {
        min-height: 320px;
      }

      .orbit {
        width: 270px;
        height: 270px;
      }

      .trust-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .trust-item:nth-child(2) {
        border-right: 0;
      }

      .trust-item:nth-child(-n+2) {
        border-bottom: 1px solid var(--border);
      }

      section.content-section {
        padding: 60px 0;
      }

      .services-grid {
        grid-template-columns: 1fr;
      }

      .form-grid {
        grid-template-columns: 1fr;
      }

      .field.full {
        grid-column: auto;
      }

      .booking-form {
        padding: 22px 17px;
      }

      .cta-inner {
        align-items: flex-start;
        flex-direction: column;
      }

      .footer-grid {
        grid-template-columns: 1fr;
        gap: 25px;
      }

      .copyright {
        flex-direction: column;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        transition: none !important;
      }
    }







/* ===== SysNexa Professional Image Gallery ===== */

.image-showcase {
  padding: 65px 0;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(56,189,248,.09), transparent 65%),
    #08172a;
  border-bottom: 1px solid var(--border);
}

.image-showcase-heading {
  text-align: center;
  margin-bottom: 32px;
}

.image-showcase-heading h2 {
  font-size: clamp(27px, 4vw, 38px);
  line-height: 1.25;
  margin-bottom: 12px;
}

.image-showcase-heading h2 span {
  color: var(--blue);
}

.image-showcase-heading p {
  color: var(--muted);
  max-width: 650px;
  margin: 0 auto;
}

.image-showcase-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.showcase-card {
  position: relative;
  min-width: 0;
  height: 290px;
  overflow: hidden;
  border-radius: 15px;
  border: 1px solid var(--border);
  background: var(--surface);
  isolation: isolate;
}

.showcase-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .5s ease;
}

.showcase-card:hover img {
  transform: scale(1.07);
}

.showcase-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(3, 12, 25, .97) 0%,
    rgba(3, 12, 25, .55) 38%,
    rgba(3, 12, 25, .02) 100%
  );
  z-index: 0;
  pointer-events: none;
}

.showcase-caption {
  position: absolute;
  z-index: 1;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px 17px;
}

.showcase-caption span {
  display: inline-block;
  color: var(--blue);
  background: rgba(7, 20, 38, .78);
  border: 1px solid rgba(56,189,248,.3);
  border-radius: 5px;
  padding: 3px 8px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.showcase-caption h3 {
  font-size: 18px;
  line-height: 1.3;
  margin-bottom: 5px;
}

.showcase-caption p {
  color: #d2deed;
  font-size: 12px;
  line-height: 1.6;
}

.image-feature {
  padding: 65px 0;
  background: var(--bg);
}

.image-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 45px;
}

.image-feature-photo {
  position: relative;
  min-height: 350px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--surface);
}

.image-feature-photo img {
  position: absolute;
  width: 100%;
  height: 100%;
  inset: 0;
  object-fit: cover;
}

.image-feature-content h2 {
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.25;
  margin-bottom: 16px;
}

.image-feature-content h2 span {
  color: var(--blue);
}

.image-feature-content p {
  color: var(--muted);
  margin-bottom: 20px;
}

.image-feature-points {
  list-style: none;
  display: grid;
  gap: 12px;
  margin-bottom: 25px;
}

.image-feature-points li {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

.image-feature-points li span {
  color: var(--green);
}

@media (max-width: 900px) {
  .image-showcase-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .showcase-card {
    height: 270px;
  }

  .image-feature-grid {
    gap: 28px;
  }
}

@media (max-width: 600px) {
  .image-showcase {
    padding: 48px 0;
  }

  .image-showcase-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .showcase-card {
    height: 280px;
  }

  .image-feature {
    padding: 45px 0;
  }

  .image-feature-grid {
    grid-template-columns: 1fr;
  }

  .image-feature-photo {
    min-height: 260px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .showcase-card img {
    transition: none;
  }
}




  </style>
</head>

<body>

  <div class="topbar">
    <div class="container">
      <span>Professional Technology Repair & IT Support</span>
      <span>Desktop · Laptop · Mobile · Networking</span>
    </div>
  </div>

  <header>
    <nav class="navbar container" aria-label="Main navigation">
      <a class="logo" href="#home" aria-label="SysNexa home">
        <div class="logo-icon">⌘</div>
        <div>Sys<span>Nexa</span></div>
      </a>

      <button class="menu-toggle" id="menuToggle"
        aria-label="Toggle navigation" aria-expanded="false">☰</button>

      <div class="nav-links" id="navLinks">
        <a href="#home">Home</a>
        <a href="#services">Services</a>
